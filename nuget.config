<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One source, so central package management needs no source mapping (NU1507) and
       restores do not depend on whatever feeds a developer has configured globally. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
